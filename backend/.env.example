# LocalAd Backend – Umgebungsvariablen
# Kopieren nach .env und Werte eintragen
# .env niemals committen (in .gitignore eintragen)

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development                        # development | production
ALLOWED_ORIGINS=http://localhost:5173       # Kommagetrennt für mehrere

# ── Datenbank (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=localad
DB_USER=localad
DB_PASSWORD=dein_sicheres_passwort

# ── Auth (JWT) ────────────────────────────────────────────────
JWT_SECRET=min_32_zeichen_langer_zufallsstring
JWT_EXPIRES_IN=15m                          # Access Token Laufzeit
JWT_REFRESH_EXPIRES_IN=30d                  # Refresh Token Laufzeit

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_USER_MONTHLY=price_1TbGCT2Le8mPgNhkvAPY7GV0        # 3 €/Monat Endnutzer-Abo
STRIPE_PRICE_ADVERTISER_BASIC=price_1TbGF12Le8mPgNhkAQX2P0fj    # 50 €/Monat
STRIPE_PRICE_ADVERTISER_STANDARD=price_1TbGFb2Le8mPgNhkGONFjs8m # 100 €/Monat
STRIPE_PRICE_ADVERTISER_PREMIUM=price_1TbGG52Le8mPgNhkBxl2PRZr  # 200 €/Monat

# ── Google Places API ─────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIza...

# ── SerpAPI (Google Events) ───────────────────────────────────
SERPAPI_KEY=...
