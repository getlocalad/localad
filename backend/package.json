{
  "name": "localad-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
